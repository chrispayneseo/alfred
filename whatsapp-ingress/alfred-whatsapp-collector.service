[Unit]
Description=Alfred receive-only WhatsApp collector
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/alfred-node/whatsapp-ingress
EnvironmentFile=/opt/alfred-node/whatsapp-ingress/collector.env
Environment=ALFRED_WHATSAPP_DB=/opt/alfred-node/whatsapp-ingress/collector-data/whatsapp-inbox.sqlite3
ExecStart=/usr/bin/python3 -B /opt/alfred-node/whatsapp-ingress/collector.py
Restart=always
RestartSec=15
UMask=0077
NoNewPrivileges=yes

[Install]
WantedBy=default.target
