# Generate a long random value for this token. Never commit a real value.
ALFRED_CORE_API_TOKEN=replace-with-a-long-random-token

# Optional. Defaults to ./data/audit.jsonl
ALFRED_AUDIT_PATH=./data/audit.jsonl

# Required for durable memory, plans, approvals and audit events. Apply
# db/migrations/001_core.sql before setting this in a running environment.
ALFRED_DATABASE_URL=postgres://alfred:replace-me@localhost:5432/alfred_core

# UUID of Chris's row in alfred_users. This is intentionally separate from the
# API display identity, so database access remains explicit and scoped.
ALFRED_OWNER_ID=00000000-0000-0000-0000-000000000000
