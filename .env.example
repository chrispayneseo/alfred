# Notion internal integration secret (notion.so/my-integrations)
NOTION_TOKEN=

# Parent page ID the integration is shared with — where the 5 databases live.
NOTION_PARENT_PAGE_ID=

# Filled in automatically by `npm run notion:setup` — leave blank until then.
NOTION_INBOX_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_NOTES_DB_ID=
NOTION_JOURNAL_DB_ID=
NOTION_PROJECTS_DB_ID=

# Postgres connection string (Neon, provisioned via Vercel's Storage/
# Marketplace tab — "Vercel Postgres" itself was discontinued in favor of
# Marketplace integrations). Same database for local dev and production —
# holds Google OAuth tokens, the Gmail metadata cache, nudge push-history,
# and sync/scan job status (Step 9: deploy). Schema is created automatically
# on first request (server/db.ts's ensureSchema).
DATABASE_URL=

# console.anthropic.com — used for Chat and for classifying captures
ANTHROPIC_API_KEY=

# platform.openai.com — used for Chat's non-coding lane
OPENAI_API_KEY=

# Optional — defaults to gpt-5.6-terra (balanced cost/intelligence) if unset
OPENAI_MODEL=

# console.cloud.google.com — OAuth client (Web application type). Locally the
# redirect URI defaults to http://localhost:5173/api/google/oauth/callback;
# in production set GOOGLE_REDIRECT_URI explicitly (below) and add that exact
# URL to the OAuth client's Authorized redirect URIs list too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production only — e.g. https://your-app.vercel.app/api/google/oauth/callback.
# Leave unset locally (falls back to the localhost default above). Must also
# be added to the Google Cloud Console OAuth client's redirect URI list.
GOOGLE_REDIRECT_URI=

# Connected Google accounts now live in Postgres (DATABASE_URL above), not
# here — connect from the app (Today screen, or Settings → Google accounts)
# after everything else is configured.

# ntfy.sh topic for push nudges — pick something unguessable, ntfy topics
# aren't private unless you add auth. Anyone who knows the topic can read it.
# Subscribe at https://ntfy.sh/<topic> (web) or the ntfy app to receive pushes.
NTFY_TOPIC=

# CoachPlan (separate sports-coaching PWA) read-only cross-reference —
# Supabase project → Settings → API. Use the publishable/anon key, never
# the secret/service_role key: Alfred only ever reads (upcoming training
# sessions + matches for one team), and the publishable key enforces
# that at the database level via CoachPlan's own Row Level Security,
# rather than relying on Alfred's own code to behave. Leave all three
# unset to skip this integration entirely — Football Coaching then falls
# back to whatever's noted manually in Notion, same as before.
COACHPLAN_SUPABASE_URL=
COACHPLAN_SUPABASE_KEY=
COACHPLAN_TEAM_ID=

# Open-Meteo (free, no API key) weather for the Today screen + Chat Q&A.
# Fixed home location as "lat,lon" — resolved once via Open-Meteo's free
# geocoding API rather than a place name looked up on every request. Below
# is Romsey, Hampshire, UK; leave unset to skip the weather feature entirely.
WEATHER_LOCATION=50.9891,-1.4999

# Shared secret for the /api/location-trigger webhook — Tasker (running
# natively on your phone, doing the actual geofence detection) sends this as
# a query param when a geofence fires. Treat it like an API key: this is a
# public URL, and anyone with a valid token can trigger reminders. Generate
# with `openssl rand -hex 24`.
LOCATION_TRIGGER_SECRET=
