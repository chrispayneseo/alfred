# Notion internal integration secret (notion.so/my-integrations)
NOTION_TOKEN=

# Parent page ID the integration is shared with — where the 5 databases live.
NOTION_PARENT_PAGE_ID=

# Filled in automatically by `npm run notion:setup` — leave blank until then.
NOTION_INBOX_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_NOTES_DB_ID=
NOTION_JOURNAL_DB_ID=
NOTION_PROJECTS_DB_ID=
