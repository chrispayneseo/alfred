# Copy to .env and replace every placeholder before starting.
ALFRED_API_KEY=replace-with-a-long-random-secret
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_ROUTER_MODEL=qwen3:1.7b
SQLITE_PATH=/data/alfred.db

# Optional free phone notifications for approved reminders. ntfy.sh topics are
# public: use a random 32+ character topic and only send generic alert text.
# Install the ntfy phone app and subscribe to the same topic before enabling.
ALFRED_NTFY_TOPIC=
# Date-only reminders notify at this hour in Europe/London (0-23).
ALFRED_REMINDER_HOUR=9

# Optional integrations. Leave blank to disable.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
