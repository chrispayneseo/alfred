# Copy to .env and replace every placeholder before starting.
ALFRED_API_KEY=replace-with-a-long-random-secret
ALFRED_TIMEZONE=Europe/London
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_ROUTER_MODEL=qwen3:1.7b
SQLITE_PATH=/data/alfred.db

# Optional cloud specialists. Leave the key blank to disable that provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ALFRED_CLOUD_TIMEOUT_SECONDS=120

# Optional integrations. Leave blank to disable.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional read-only local files integration. Core only sees the dedicated
# container path mounted at /files; arbitrary host filesystem paths are not exposed.
# Hidden entries, symlinks, binary reads and parent traversal are rejected.
ALFRED_FILES_ENABLED=false
ALFRED_FILES_ROOT=/files
ALFRED_FILES_MAX_READ_BYTES=262144

# Phase 5F controlled browser. Start the compose `browser` profile only after
# setting a long random worker token. Browser navigation is a separate opt-in
# from high-impact submission. Even with submission enabled, every browser.submit
# still requires Core's exact-scope owner approval before the worker is called.
ALFRED_BROWSER_ENABLED=false
ALFRED_BROWSER_SUBMIT_ENABLED=false
ALFRED_BROWSER_WORKER_URL=http://browser-worker:8090
ALFRED_BROWSER_WORKER_TOKEN=
ALFRED_BROWSER_TIMEOUT_SECONDS=25
ALFRED_BROWSER_MAX_SESSIONS=3
ALFRED_BROWSER_SESSION_TTL_SECONDS=1800
ALFRED_BROWSER_NAVIGATION_TIMEOUT_MS=15000

# Optional Google Calendar integration. Obtain a refresh token outside this
# file and store real credential values only in the private Dell .env.
# Reads work whenever the integration is configured. Writes additionally require
# a write-capable OAuth scope and GOOGLE_CALENDAR_WRITE_ENABLED=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_WRITE_ENABLED=false
ALFRED_GOOGLE_TIMEOUT_SECONDS=20

# Optional Gmail read-only integration. Keep this token at read-only scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me
ALFRED_GMAIL_TIMEOUT_SECONDS=20

# Optional Gmail draft integration. These credentials are intentionally separate
# from Gmail reads. Use only a write-capable scope required for draft creation.
# Draft creation remains unavailable until the explicit gate is enabled.
GMAIL_WRITE_CLIENT_ID=
GMAIL_WRITE_CLIENT_SECRET=
GMAIL_WRITE_REFRESH_TOKEN=
GMAIL_WRITE_USER_ID=me
GMAIL_WRITE_ENABLED=false

# Phase 4 proactive observation. Disabled by default. When enabled Alfred only
# refreshes a local observation feed; it does not push messages or take actions.
ALFRED_PROACTIVE_ENABLED=false
ALFRED_PROACTIVE_POLL_SECONDS=900
ALFRED_PROACTIVE_QUIET_START=22:00
ALFRED_PROACTIVE_QUIET_END=07:00
ALFRED_PROACTIVE_MIN_PRIORITY=60
ALFRED_PROACTIVE_COOLDOWN_MINUTES=180
ALFRED_PROACTIVE_TASK_HORIZON_DAYS=2
ALFRED_PROACTIVE_CALENDAR_HOURS=24
ALFRED_PROACTIVE_GMAIL_QUERY=is:unread newer_than:2d

# Phase 4C morning brief. This remains local and is only generated in the
# background when ALFRED_PROACTIVE_ENABLED=true. Manual authenticated generation
# is available for validation even while the background observer is disabled.
ALFRED_PROACTIVE_MORNING_BRIEF_ENABLED=true
ALFRED_PROACTIVE_MORNING_BRIEF_TIME=08:00
ALFRED_PROACTIVE_MORNING_BRIEF_MAX_ITEMS=8
ALFRED_PROACTIVE_BRIEF_RETENTION_DAYS=14


# Account-level development integrations. Use tokens scoped to the account/work
# Alfred is authorised to operate. Secrets belong only in the private Dell .env.
GITHUB_TOKEN=
GITHUB_OWNER=chrispayneseo
VERCEL_TOKEN=
VERCEL_TEAM_ID=
ALFRED_DEVELOPER_PLATFORM_TIMEOUT_SECONDS=25
