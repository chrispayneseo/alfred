# Copy to .env and replace every placeholder before starting.
ALFRED_API_KEY=replace-with-a-long-random-secret
ALFRED_TIMEZONE=Europe/London
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_ROUTER_MODEL=qwen3:1.7b
SQLITE_PATH=/data/alfred.db

# Optional cloud specialists. Leave the key blank to disable that provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ALFRED_CLOUD_TIMEOUT_SECONDS=120

# Optional integrations. Leave blank to disable.
HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional read-only local files integration. Core only sees the dedicated
# container path mounted at /files; arbitrary host filesystem paths are not exposed.
# Hidden entries, symlinks, binary reads and parent traversal are rejected.
ALFRED_FILES_ENABLED=false
ALFRED_FILES_ROOT=/files
ALFRED_FILES_MAX_READ_BYTES=262144

# Optional Google Calendar integration. Obtain a refresh token outside this
# file and store real credential values only in the private Dell .env.
# Reads work whenever the integration is configured. Writes additionally require
# a write-capable OAuth scope and GOOGLE_CALENDAR_WRITE_ENABLED=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_WRITE_ENABLED=false
ALFRED_GOOGLE_TIMEOUT_SECONDS=20

# Optional Gmail read-only integration. Keep this token at read-only scope.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me
ALFRED_GMAIL_TIMEOUT_SECONDS=20

# Optional Gmail draft integration. These credentials are intentionally separate
# from Gmail reads. Use only a write-capable scope required for draft creation.
# Draft creation remains unavailable until the explicit gate is enabled.
GMAIL_WRITE_CLIENT_ID=
GMAIL_WRITE_CLIENT_SECRET=
GMAIL_WRITE_REFRESH_TOKEN=
GMAIL_WRITE_USER_ID=me
GMAIL_WRITE_ENABLED=false
