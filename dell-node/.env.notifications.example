# Copy to .env.notifications. Never commit the real file.
# ntfy.sh topics are public; use a random 32+ character topic.
ALFRED_NTFY_TOPIC=
# Date-only reminders notify at this hour in Europe/London (0-23).
ALFRED_REMINDER_HOUR=9
# Phase 4F proactive phone nudges are separately opt-in. Alfred only sends a
# generic prompt to open Today; connected item content never goes in the push.
ALFRED_PROACTIVE_PUSH_ENABLED=false
# Phase 4G can send one generic "morning brief ready" nudge per local day.
# It remains subordinate to the main proactive push gate and quiet hours.
ALFRED_PROACTIVE_MORNING_BRIEF_PUSH_ENABLED=false
